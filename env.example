# Rename this file to "config.env" (or ".env") and fill in real values.
# Never commit the real config.env / .env file to version control.

OPENAI_API_KEY="sk-..."
TAVILY_API_KEY="tvly-..."
OPENAI_BASE_URL="https://openai.vocareum.com/v1"

# Optional overrides
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
FAISS_INDEX_DIR="faiss_index_udaplay"
LOG_LEVEL="INFO"
